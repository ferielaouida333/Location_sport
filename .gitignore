# Ne jamais uploader les identifiants BDD
config.php

# Ne pas uploader les photos (trop lourdes, locales)
uploads/*

# Garder le dossier uploads/ mais pas son contenu
!uploads/.gitkeep

# Fichiers système Windows/Mac
Thumbs.db
.DS_Store

# Fichier de test temporaire
test.php
